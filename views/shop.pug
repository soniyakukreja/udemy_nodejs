doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title #{doctTitle}
        link(rel="stylesheet", href="/css/main.css")
    body
        header.main-header
            nav.main-header__nav
                ul.main-header__item-list
                    li.main-header__item
                        a.active(href="/") Shop
                    li.main-header__item
                        a(href="/admin/add-products") Add Product
        main
            if prods.length > 0
                .grid
                    each product in prods
                        artical.card.product-item
                            header.card__header
                                h1.product_title #{product.title}
                            .card_image
                                img(src="https://s26162.pcdn.co/wp-content/uploads/sites/2/2022/08/Books.jpg", alt="A Book")
                            .card_content
                                h2.product_price $19.99
                                p.product_description A very interesting book
                            .card_actions
                                button.btn Add to Cart
            else
                h1 Not Products