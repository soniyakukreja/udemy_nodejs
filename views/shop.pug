extends layouts/main-layout.pug

block styles 
    link(rel="stylesheet", href="/css/product.css")

block content
    if prods.length > 0
        .grid
            each product in prods
                article.card.product-item
                    header.card__header
                        h1.product__title #{product.title}
                    .card__image
                        img(src="https://s26162.pcdn.co/wp-content/uploads/sites/2/2022/08/Books.jpg", alt="A Book")
                    .card__content
                        h2.product__price $19.99
                        p.product__description A very interesting book
                    .card__actions
                        button.btn Add to Cart
    else
        .no-products
            h1 No Products Found!
            p Please add some products to see them here.