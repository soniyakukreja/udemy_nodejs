extends layouts/main-layout.pug
block styles 
    link(rel="stylesheet", href="/css/product.css")
block content
    if prods.length > 0
        .grid
            each product in prods
                artical.card.product-item
                    header.card__header
                        h1.product_title #{product.title}
                    .card_image
                        img(src="https://s26162.pcdn.co/wp-content/uploads/sites/2/2022/08/Books.jpg", alt="A Book")
                    .card_content
                        h2.product_price $19.99
                        p.product_description A very interesting book
                    .card_actions
                        button.btn Add to Cart
    else
        h1 Not Products